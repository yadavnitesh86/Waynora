# Waynora frontend environment configuration
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and should never be committed.

# FastAPI backend base URL (local development)
VITE_API_BASE_URL=http://localhost:8000

# Convex deployment URL — find it in .env.local (already present) or:
# https://dashboard.convex.dev → Project → Settings → URL
VITE_CONVEX_URL=

# --- Convex Auth deployment variables (NOT VITE_, never committed) ---
# These are set on the Convex deployment itself, not in .env.local.
# Generate with the official Convex Auth key script (jose), then:
#   npx convex env set JWT_PRIVATE_KEY="<pasted>"
#   npx convex env set JWKS=<pasted>
# Or via Dashboard → Deployment → Settings → Environment Variables.
# JWT_PRIVATE_KEY: RS256 PKCS8 private key (newlines replaced with spaces).
# JWKS: JSON Web Key Set — {"keys":[{"use":"sig", ...public key JWK...}]}.
# Both are required for the Password provider to issue sessions.
