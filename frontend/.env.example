# Waynora frontend environment configuration
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and should never be committed.

# FastAPI backend base URL (local development)
VITE_API_BASE_URL=http://localhost:8000

# Convex deployment URL — find it in .env.local (already present) or:
# https://dashboard.convex.dev → Project → Settings → URL
VITE_CONVEX_URL=
